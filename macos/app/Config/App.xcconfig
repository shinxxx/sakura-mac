// App 的名字、Bundle ID 和版本集中在这里。改名时只需要改这个文件。

// 显示名称（菜单栏、关于窗口、Dock）
APP_DISPLAY_NAME = Sakura Editor for Mac
PRODUCT_NAME = $(APP_DISPLAY_NAME)

// Bundle ID 上架后不能更改，因此刻意不包含 “Sakura”，以便日后改名。
// 2026-11-08 确定。用中性的品牌名，不含个人信息。
PRODUCT_BUNDLE_IDENTIFIER = com.hanagumo.texteditor

// 最低支持的 macOS 版本（2026-11-08 确定为 macOS 13）
// 第 24 步改成 13.3：原版代码用的 std::format 需要 macOS 13.3 的 C++ 标准库（std::to_chars）。
// macOS 13 的用户都能免费更新到 13.3 以上。
MACOSX_DEPLOYMENT_TARGET = 13.3

// 只支持 Apple 芯片（arm64），不支持 Intel 芯片（2026-11-26 项目负责人决定）。
// Debug・Release、App・桥接层框架・测试都只编 arm64（核心库由 Scripts/build-core.sh 按这个 ARCHS 编）
ARCHS = arm64

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// 签名用的开发团队 ID（第 37 步：2026-11-28 注册的个人账号。团队 ID 只是编号，不是密码）。
// 测试（run-tests.sh、CI）用 DEVELOPMENT_TEAM= 覆盖成空，用本机签名（ad-hoc），不需要证书。
DEVELOPMENT_TEAM = 27TKMRNG74
