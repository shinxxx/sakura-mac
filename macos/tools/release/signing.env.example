# 第 37 步：签名・上传用的设置。复制到 ~/.config/sakura-mac/signing.env 再填写（不放进仓库）。
# 这些只是编号，不是密码。API 密钥本身（.p8）放在仓库外，只写它的路径。

# 开发者账号的团队 ID（developer.apple.com/account →「メンバーシップの詳細」）
TEAM_ID=XXXXXXXXXX

# App Store Connect API 密钥（appstoreconnect.apple.com →「ユーザとアクセス」→「統合」→「App Store Connect API」）
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# altool 只在 ~/.appstoreconnect/private_keys/ 等固定位置找密钥，所以放在这里
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
